# ==============================================================================
# CONTAINER SEAL OCR - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Pipeline Model Configuration
# ------------------------------------------------------------------------------
MODEL_VERSION=seal-det-v1.0.0-rec-v1.0.0

# Đường dẫn mô hình YOLO Seal Detector
SEAL_DETECTOR_MODEL=models/seal-det-v1.0.0/best.onnx

# Thư mục mô hình PaddleOCR Seal Recognition v1
RECOGNITION_MODEL_DIR=models/seal-rec-v1.0.0

# ------------------------------------------------------------------------------
# 2. Detector Hyperparameters
# ------------------------------------------------------------------------------
SEAL_DETECTOR_INPUT_SIZE=960
SEAL_DETECTOR_CONFIDENCE=0.50
SEAL_DETECTOR_IOU=0.45
SEAL_DETECTOR_PADDING=0.18
SEAL_DETECTOR_MAX_REGIONS=3

# ------------------------------------------------------------------------------
# 3. Processing Limits & Thresholds
# ------------------------------------------------------------------------------
# Thời gian xử lý tối đa (SLA: Prod 9s | UAT 10s | Dev 15s)
OCR_TIMEOUT_SECONDS=9

# Kích thước file tối đa (MB)
MAX_UPLOAD_MB=10

# Giới hạn kích thước ảnh
MAX_PIXELS=40000000
MAX_SIDE=2048
MIN_SIDE=160

# Ngưỡng kiểm tra chất lượng ảnh thô
BLUR_THRESHOLD=20
DARK_THRESHOLD=15
BRIGHT_THRESHOLD=240

# Ngưỡng phân loại tin cậy
SUCCESS_THRESHOLD=0.90
REVIEW_THRESHOLD=0.70

# ------------------------------------------------------------------------------
# 4. Seal Validation Pattern & Length
# ------------------------------------------------------------------------------
SEAL_ALLOWED_PATTERN=^[A-Z0-9]+$
SEAL_MIN_LENGTH=5
SEAL_MAX_LENGTH=20
